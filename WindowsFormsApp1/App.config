<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <!--
        .NET Framework 4.x 中 System.Windows.Forms 的真实程序集版本是 4.0.30319，
        原配置写成 4.0.0.0，运行时会找不到目标版本而触发 FileLoadException。
        这里同时保留一条指向 4.0.0.0 的重定向，兼容个别仍以旧版本号引用
        程序集名的第三方组件。
      -->
      <dependentAssembly>
        <assemblyIdentity name="System.Windows.Forms" publicKeyToken="b77a5c561934e089" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.0.0" newVersion="4.0.30319" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.30319" newVersion="4.0.30319" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Drawing" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.0.0" newVersion="4.0.30319" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.30319" newVersion="4.0.30319" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
