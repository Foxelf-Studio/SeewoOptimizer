<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>NtpClientTests</AssemblyName>
    <RootNamespace>SeewoOpt.Tools</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="NtpClientTests.cs" />

    <!--
      直接链接产品源码，而不是复刻一份。

      这是本测试与 UpdateRetrySimulation 的关键区别：那个测的是并发时序，
      在 net10 下无法直接加载 net48 程序集，只能复刻同构状态机；
      而 NtpClient 的协议解析是纯函数，零外部依赖（只用 System.Net），
      可以直接把真实源文件编进来——测的就是发布出去的那份代码本身。

      若改为复刻，一旦产品代码改动而副本忘了同步，
      测试依然全绿，却什么也没验证到。
    -->
    <Compile Include="..\WindowsFormsApp1\Services\NtpClient.cs" />
    <Compile Include="..\WindowsFormsApp1\Services\LogService.cs" />
    <!--
      关机调度的纯逻辑与设置序列化。这两个文件是本次新增功能的核心判定部分，
      不含任何 UI 依赖（ShutdownSchedule.cs 只用 System，
      SettingsStore.cs 只用 Microsoft.Win32 + System），因此可以直接编进测试。
      注意 SettingsStore.cs 里读写的注册表路径仍是产品路径——
      测试只调用它的 Serialize/Deserialize 这两个纯函数，不碰注册表。
    -->
    <Compile Include="..\WindowsFormsApp1\Services\ShutdownSchedule.cs" />
    <Compile Include="..\WindowsFormsApp1\Services\SettingsStore.cs" />
    <!--
      守护天数起始日的可信度判定。可以链接真实源码：它是纯函数，
      只依赖 System.DateTime，零 UI 依赖。
      这一点很关键——"实机那条 2000-01-01 的记录会被判定为不可信"
      这条断言，测的必须是产品真正用的那份判断。
    -->
    <Compile Include="..\WindowsFormsApp1\Services\GuardDayPolicy.cs" />
    <Compile Include="..\WindowsFormsApp1\Services\AutoStartTaskUpgradePolicy.cs" />
    <!--
      ShutdownService 本身（不只是它的纯逻辑）也要编进来。
      原因：本轮把"到点关机"的判定从"每轮从规则实时推导"改成了
      "由承诺时刻驱动"，而承诺状态（_promisedAt）与记账状态都活在这个类里。
      若只测 ShutdownScheduleLogic 而跳过它，就测不到"承诺后到点是否真会关"
      这条主链路——而那恰恰是删掉二次确认框之后唯一的关机触发路径。
      它只依赖 System + LogService（已在上方编入），无 UI 依赖。
    -->
    <Compile Include="..\WindowsFormsApp1\Services\ShutdownService.cs" />
    <!--
      签名验证也链接真实源码。换钥过渡的逻辑（“当前 + 下一把”都受信）
      必须能被测试直接验证：测试自己生成两对 RSA 密钥，用第二把签名，
      再分别用“只有第一把”和“两把都有”去验。这把产品内置的真钥
      完全不需要出现在测试里。
    -->
    <Compile Include="..\WindowsFormsApp1\Services\SignatureVerifier.cs" />
    <Compile Include="..\WindowsFormsApp1\Services\UpdateSourcePolicy.cs" />
    <!--
      Release JSON 解析由 GitHub 与 Gitee 共用，是两条更新链路里唯一
      完全可离线验证的部分。Gitee 的资产对象没有 size 字段、
      资产列表里还混着源码包——这两点必须由测试钉住。
    -->
    <Compile Include="..\WindowsFormsApp1\Services\ReleaseInfoParser.cs" />
    <!--
      失败上报的脱敏与节流是纯逻辑，必须能离线验证：
      "发出去的日志里不许有用户名/IP"这条如果只靠肉眼，迟早会漏。
    -->
    <Compile Include="..\WindowsFormsApp1\Services\BuildInfo.cs" />
    <Compile Include="..\WindowsFormsApp1\Services\CrashReporter.cs" />
  </ItemGroup>
</Project>
