<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>NtpClientTests</AssemblyName>
    <RootNamespace>SeewoOpt.Tools</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="NtpClientTests.cs" />

    <!--
      直接链接产品源码，而不是复刻一份。

      这是本测试与 UpdateRetrySimulation 的关键区别：那个测的是并发时序，
      在 net10 下无法直接加载 net48 程序集，只能复刻同构状态机；
      而 NtpClient 的协议解析是纯函数，零外部依赖（只用 System.Net），
      可以直接把真实源文件编进来——测的就是发布出去的那份代码本身。

      若改为复刻，一旦产品代码改动而副本忘了同步，
      测试依然全绿，却什么也没验证到。
    -->
    <Compile Include="..\WindowsFormsApp1\Services\NtpClient.cs" />
    <Compile Include="..\WindowsFormsApp1\Services\LogService.cs" />
    <!--
      关机调度的纯逻辑与设置序列化。这两个文件是本次新增功能的核心判定部分，
      不含任何 UI 依赖（ShutdownSchedule.cs 只用 System，
      SettingsStore.cs 只用 Microsoft.Win32 + System），因此可以直接编进测试。
      注意 SettingsStore.cs 里读写的注册表路径仍是产品路径——
      测试只调用它的 Serialize/Deserialize 这两个纯函数，不碰注册表。
    -->
    <Compile Include="..\WindowsFormsApp1\Services\ShutdownSchedule.cs" />
    <Compile Include="..\WindowsFormsApp1\Services\SettingsStore.cs" />
    <!--
      ShutdownService 本身（不只是它的纯逻辑）也要编进来。
      原因：本轮把"到点关机"的判定从"每轮从规则实时推导"改成了
      "由承诺时刻驱动"，而承诺状态（_promisedAt）与记账状态都活在这个类里。
      若只测 ShutdownScheduleLogic 而跳过它，就测不到"承诺后到点是否真会关"
      这条主链路——而那恰恰是删掉二次确认框之后唯一的关机触发路径。
      它只依赖 System + LogService（已在上方编入），无 UI 依赖。
    -->
    <Compile Include="..\WindowsFormsApp1\Services\ShutdownService.cs" />
  </ItemGroup>
</Project>
